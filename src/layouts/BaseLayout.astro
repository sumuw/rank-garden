---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "一个面向排行榜内容的静态博客。"
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={baseUrl}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Ranking Blog</span>
      </a>
      <nav aria-label="主导航">
        <a href={baseUrl}>首页</a>
        <a href={`${baseUrl}categories/github/`}>GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface-muted: #f1f5f9;
    --text: #111827;
    --muted: #64748b;
    --line: #d9e2ec;
    --blue: #0369a1;
    --green: #047857;
    --amber: #b45309;
    --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--blue);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding: 0 5vw;
    background: rgba(248, 250, 252, 0.92);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .brand,
  nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand {
    font-weight: 700;
  }

  .brand-mark {
    display: inline-grid;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background:
      linear-gradient(90deg, transparent 0 20%, #38bdf8 20% 34%, transparent 34% 44%, #f59e0b 44% 58%, transparent 58% 68%, #34d399 68% 82%, transparent 82%),
      #111827;
  }

  nav a {
    color: var(--muted);
    font-size: 0.95rem;
  }

  main {
    width: min(1120px, 90vw);
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--blue);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .page-title {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1.08;
  }

  .lead {
    max-width: 720px;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .section-title {
    margin: 0 0 1rem;
    font-size: 1.35rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .panel,
  .ranking-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .panel {
    padding: 1.25rem;
  }

  .ranking-card {
    display: block;
    padding: 1rem;
  }

  .ranking-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .ranking-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-muted);
    font-size: 0.8rem;
  }

  .content {
    max-width: 760px;
  }

  .content p {
    color: #334155;
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding-top: 0.8rem;
      padding-bottom: 0.8rem;
    }

    main {
      width: min(100% - 1.5rem, 1120px);
      padding-top: 1.5rem;
    }
  }
</style>
