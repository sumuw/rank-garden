---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryLabels,
  getAllRankingPosts,
  getCategoryUrl,
  getPostUrl,
  periodLabels,
  type RankingCategory
} from "@/lib/rankings";

const posts = await getAllRankingPosts();
const latestPosts = posts.slice(0, 8);
const categories = Array.from(new Set(posts.map((post) => post.data.category))) as RankingCategory[];
const categoryCounts = categories.map((category) => ({
  category,
  count: posts.filter((post) => post.data.category === category).length,
  latest: posts.find((post) => post.data.category === category)?.data.date
}));
const moreUrl = getCategoryUrl(categories[0] || "github");
---

<BaseLayout title="Ranking Blog | 每日排行榜内容站">
  <section class="hero">
    <div>
      <p class="eyebrow">Ranking Blog</p>
      <h1 class="page-title">用结构化数据和 AI 解读维护排行榜博客。</h1>
      <p class="lead">
        首版聚焦 GitHub 日榜和周榜，后续可扩展到影视、AI 工具和其他主题榜单。
      </p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <span style="--height: 42%"></span>
      <span style="--height: 68%"></span>
      <span style="--height: 92%"></span>
      <span style="--height: 55%"></span>
    </div>
  </section>

  <section class="section category-section" aria-labelledby="category-title">
    <div class="section-header">
      <div>
        <h2 id="category-title" class="section-title">分类</h2>
        <p>按主题查看已发布的排行榜。</p>
      </div>
    </div>
    <div class="category-strip" role="list">
      {
        categoryCounts.map(({ category, count, latest }) => (
          <a class="category-link" href={getCategoryUrl(category)} role="listitem">
            <span>{categoryLabels[category]}</span>
            <small>{count} 篇 · 最近 {latest}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="section-header">
      <div>
        <h2 id="latest-title" class="section-title">最新榜单</h2>
        <p>按发布时间倒序排列。</p>
      </div>
      <a class="more-link" href={moreUrl}>更多</a>
    </div>
    <div class="ranking-list" role="list">
      {
        latestPosts.map((post) => (
          <a class="ranking-list-item" href={getPostUrl(post)} role="listitem">
            <div class="date-block">
              <span>{post.data.date}</span>
              <small>{periodLabels[post.data.period]}</small>
            </div>
            <div class="item-main">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <div class="meta-row">
              <span class="pill">{categoryLabels[post.data.category]}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 2rem;
    align-items: end;
    padding: 2rem 0 3rem;
  }

  .hero-visual {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    gap: 0.75rem;
    height: 180px;
    padding: 1rem;
    background: #111827;
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .hero-visual span {
    display: block;
    height: var(--height);
    border-radius: 6px 6px 2px 2px;
    background: #38bdf8;
  }

  .hero-visual span:nth-child(2) {
    background: #f59e0b;
  }

  .hero-visual span:nth-child(3) {
    background: #34d399;
  }

  .hero-visual span:nth-child(4) {
    background: #e2e8f0;
  }

  .section {
    margin-top: 2rem;
  }

  .category-section {
    margin-top: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-header p {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .category-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .category-link span {
    font-weight: 700;
  }

  .category-link small,
  .date-block small {
    color: var(--muted);
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--blue);
    background: var(--surface);
    font-weight: 700;
  }

  .ranking-list {
    display: grid;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .ranking-list-item {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .ranking-list-item:last-child {
    border-bottom: 0;
  }

  .date-block {
    display: grid;
    gap: 0.15rem;
  }

  .date-block span {
    font-weight: 800;
  }

  .item-main h3 {
    margin: 0 0 0.3rem;
    font-size: 1.02rem;
  }

  .item-main p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      height: 120px;
    }

    .section-header,
    .ranking-list-item {
      align-items: flex-start;
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
    }
  }
</style>
